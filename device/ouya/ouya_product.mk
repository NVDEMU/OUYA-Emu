# OUYA system integration.
#
# Do not install the in-repo OUYALauncher as the console shell. The goal is
# the original OUYA dashboard from user-supplied stock firmware.
PRODUCT_PRODUCT_PROPERTIES += \
    ro.ouyaemu.profile=ouya

# Generated by tools/import_ouya_firmware.py after importing a stock OTA.
# The file is absent until the user supplies firmware they are entitled to use.
ifneq ($(wildcard vendor/ouya-emu/proprietary/ouya/ouya-imported.mk),)
include vendor/ouya-emu/proprietary/ouya/ouya-imported.mk
endif

# OUYALauncher remains a development fallback only; it is intentionally not
# added to PRODUCT_PACKAGES so it cannot replace the authentic OUYA dashboard.
